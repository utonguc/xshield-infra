# xShield Pet (pet.xshield.com.tr)
PET_DB_NAME=petdb
PET_DB_USER=pet
PET_DB_PASS=CHANGE_ME
# /yonetim ekranına erişecek e-postalar (virgülle ayrılmış)
PET_ADMIN_EMAILS=
# sync-pet-domains.sh için iç token (en az 16 karakter, rastgele): openssl rand -hex 24
PET_INTERNAL_TOKEN=CHANGE_ME
# Müşterilerin CNAME kaydının hedefi
PET_CUSTOM_DOMAIN_TARGET=pet.xshield.com.tr
# İsteğe bağlı — Cloudflare for SaaS (SSL for SaaS) otomasyonu
# Token izni: Zone → SSL and Certificates → Edit (yalnızca xshield.com.tr zone'u)
PET_CF_API_TOKEN=
PET_CF_ZONE_ID=
